# Application
APP_NAME=FlashReserve
APP_ENV=development
APP_HOST=127.0.0.1
PORT=5000
API_BASE_URL=http://127.0.0.1:5000
RAFT_API_BASE_URL=http://127.0.0.1:5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/
STANDALONE_DB_NAME=flashreserve

# Authentication
JWT_SECRET=change_this_to_a_secure_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# gRPC
GRPC_HOST=127.0.0.1

# Raft Cluster
RAFT_CLUSTER_SIZE=7
RAFT_NODE_ID=node-1
RAFT_ELECTION_TIMEOUT_MIN=3
RAFT_ELECTION_TIMEOUT_MAX=5
RAFT_HEARTBEAT_INTERVAL=0.5
RAFT_RPC_TIMEOUT=2
# Raft nodes may share one Atlas URI; each node selects its own database.
RAFT_NODE_1_HOST=127.0.0.1
RAFT_NODE_1_PORT=50051
RAFT_NODE_1_DATABASE_NAME=flashreserve_raft_node1
RAFT_NODE_1_MONGO_URI=mongodb://localhost:27017/
RAFT_NODE_2_HOST=127.0.0.1
RAFT_NODE_2_PORT=50052
RAFT_NODE_2_DATABASE_NAME=flashreserve_raft_node2
RAFT_NODE_2_MONGO_URI=mongodb://localhost:27017/
RAFT_NODE_3_HOST=127.0.0.1
RAFT_NODE_3_PORT=50053
RAFT_NODE_3_DATABASE_NAME=flashreserve_raft_node3
RAFT_NODE_3_MONGO_URI=mongodb://localhost:27017/
RAFT_NODE_4_HOST=127.0.0.1
RAFT_NODE_4_PORT=50054
RAFT_NODE_4_DATABASE_NAME=flashreserve_raft_node4
RAFT_NODE_4_MONGO_URI=mongodb://localhost:27017/
RAFT_NODE_5_HOST=127.0.0.1
RAFT_NODE_5_PORT=50055
RAFT_NODE_5_DATABASE_NAME=flashreserve_raft_node5
RAFT_NODE_5_MONGO_URI=mongodb://localhost:27017/
RAFT_NODE_6_HOST=127.0.0.1
RAFT_NODE_6_PORT=50056
RAFT_NODE_6_DATABASE_NAME=flashreserve_raft_node6
RAFT_NODE_6_MONGO_URI=mongodb://localhost:27017/
RAFT_NODE_7_HOST=127.0.0.1
RAFT_NODE_7_PORT=50057
RAFT_NODE_7_DATABASE_NAME=flashreserve_raft_node7
RAFT_NODE_7_MONGO_URI=mongodb://localhost:27017/

# LLM
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=replace-with-provider-key
LLM_GRPC_HOST=127.0.0.1
LLM_GRPC_PORT=50060

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=replace-with-gmail-address
SMTP_PASSWORD=replace-with-gmail-app-password
SMTP_FROM_NAME=FlashReserve